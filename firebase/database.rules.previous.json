{
  "rules": {
    ".read": false,
    ".write": false,
    "mp_rooms": {
      "$roomCode": {
        ".read": true,
        ".write": true,
        ".validate": "$roomCode.matches(/^[0-9]{4}$/)"
      }
    },
    "leaderboards": {
      ".read": true,
      ".write": true
    },
    "transfer_arena_v1": {
      ".read": "auth != null && auth.uid === 'transfer-arena-server'",
      ".write": "auth != null && auth.uid === 'transfer-arena-server'"
    }
  }
}
